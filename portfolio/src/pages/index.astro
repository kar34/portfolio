---
import Layout from '../layouts/Layout.astro';
import WorkCards from '../components/WorkCards.astro';
import WorkIndex from '../components/WorkIndex.astro';
---

<Layout
  title="Kenny Raymond - Product Designer"
  description="Kenny Raymond is a Staff Product Designer based in Los Angeles. 10+ years shaping high-impact consumer and B2B products at LinkedIn, Facebook, and Workday."
  ogImage="/bw-ken-big.png"
>
  <!-- Hero wrapper — the left text column fades + slides left, the portrait
       scales down + slides left, and the About block slides in from off-screen
       right to land as a centered [portrait + About] composition. 180svh gives
       the sticky section 80svh of scroll; the motion completes in the first
       ~75% (~60svh), leaving a short ~20svh rest before Work takes over. -->
  <div class="hero-wrapper relative min-h-[180svh]">
  <!-- Hero Section — sticky, clips the exiting/entering layers via overflow-hidden -->
  <section data-no-reveal class="hero-section sticky top-0 h-[100svh] overflow-hidden">

    <!-- Hero content layer — left text fades + slides left on scroll;
         right portrait scales down + slides left. -->
    <div class="absolute inset-0 flex items-center px-[6vw] md:px-[8vw]">
      <div class="hero-grid grid grid-cols-1 md:grid-cols-[1.05fr_1fr] gap-10 md:gap-16 items-center w-full">

        <!-- Left column: name, thesis, body, CTA -->
        <div class="hero-text flex flex-col items-center md:items-start text-center md:text-left order-2 md:order-1 will-change-[opacity,transform]">

          <h1 class="hero-name text-[clamp(3rem,7.8vw,11rem)] font-medium uppercase tracking-tight leading-[0.95]">
            Kenny<br />Raymond
          </h1>

          <p class="hero-thesis text-[clamp(1.4rem,2.6vw,2.8rem)] font-medium leading-[1.15] mt-6 md:mt-8 max-w-[18ch]">
            Turning ambiguity into shipped products
          </p>

          <p class="hero-body text-base md:text-lg text-white/70 leading-relaxed mt-4 md:mt-5 max-w-[42ch]">
            Staff Product Designer leading 0→1 product strategy, systems, and high-craft execution.
          </p>

          <div class="hero-buttons flex flex-row flex-wrap justify-center md:justify-start gap-3 md:gap-4 mt-8 md:mt-10">
            <a
              id="hero-view-work"
              href="#work-section"
              class="group inline-flex items-center gap-2 bg-white text-black rounded-full px-6 py-3.5 font-medium text-base md:text-lg transition-transform hover:scale-[1.02]"
            >
              View Work
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-y-0.5" aria-hidden="true">
                <line x1="9" y1="3" x2="9" y2="15"></line>
                <polyline points="4 10 9 15 14 10"></polyline>
              </svg>
            </a>
          </div>
        </div>

        <!-- Right column: large circular portrait — scales down + slides left
             on scroll so it sits beside the incoming About block. Static x on mobile. -->
        <div class="hero-portrait-wrap flex justify-center md:justify-end order-1 md:order-2 mt-[12svh] md:mt-0 will-change-transform">
          <div class="hero-portrait w-[180px] h-[180px] md:w-[clamp(220px,32vw,520px)] md:h-[clamp(220px,32vw,520px)] rounded-full overflow-hidden ring-[3px] ring-white shrink-0">
            <img
              src="/bw-ken-big.png"
              alt="Kenny Raymond portrait"
              class="w-full h-full object-cover"
              draggable="false"
            />
          </div>
        </div>

      </div>
    </div>

    <!-- About overlay — on desktop it slides in from off-screen right, landing
         beside the shrunken portrait (inner block nudged right via
         md:translate-x-[15vw] so the [portrait + About] bbox lands centered).
         On mobile it rises up from below and rests in the lower half (inner
         block pushed down via translate-y-[20svh]) so it never overlaps the
         portrait, which stays put up top. Holds the home bio + "My approach" CTA. -->
    <div class="hero-about-slide absolute inset-0 flex items-center justify-center px-[6vw] md:px-[8vw] will-change-transform" style="transform: translateX(100vw)">
      <div class="max-w-[80vw] md:max-w-[34vw] translate-y-[20svh] md:translate-y-0 md:translate-x-[15vw]">
        <h2 class="text-[14vw] md:text-5xl font-semibold uppercase tracking-tight text-center md:text-left leading-none">
          About
        </h2>
        <p class="text-[5vw] md:text-[2.6vw] lg:text-[1.7vw] leading-snug text-white/90 mt-3 md:mt-5 text-center md:text-left text-balance">
          With 10+ years across LinkedIn, Meta, and Workday, I turn complex 0→1 product bets into clear direction, aligned teams, and shipped impact.
        </p>
        <div class="flex justify-center md:justify-start mt-6 md:mt-7">
          <a
            href="/about"
            class="group inline-flex items-center gap-2 bg-transparent border border-white/30 text-white rounded-full px-6 py-3 md:px-5 md:py-2.5 font-medium text-base hover:bg-white/10 hover:border-white/50 transition-colors"
          >
            My approach
            <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
              <line x1="3" y1="9" x2="15" y2="9"></line>
              <polyline points="10 4 15 9 10 14"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>

  </section>
  </div><!-- /hero wrapper -->

  <!-- Work Section -->
  <section id="work-section" data-no-reveal class="relative pt-48 md:pt-0 pb-32 md:pb-28 px-[6vw] md:px-[8vw]">

    <!-- Sticky full-bleed WORK heading — tiles scroll on top of it -->
    <div id="work-heading" class="-mx-[6vw] md:-mx-[8vw] md:sticky md:top-0 z-0">
      <h2 class="text-[22vw] md:text-[20vw] font-semibold uppercase tracking-tighter leading-none text-center">
        Work
      </h2>
    </div>

    <!-- Index — table of contents for the cards below.
         Sits inside the sticky-heading zone so it reads first as you enter
         the work section, then exits as the cinematic cards take over. -->
    <div class="relative z-10 mt-8 md:mt-24">
      <WorkIndex />
    </div>

    <!-- Cards — higher z-index so they layer over the heading -->
    <div class="relative z-10 mt-24 md:mt-64">
      <WorkCards />
    </div>

  </section>

</Layout>

<style>
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .hero-portrait-wrap { animation: fadeUp 0.7s ease-out both; animation-delay: 0.1s; }
  .hero-name          { animation: fadeUp 0.7s ease-out both; animation-delay: 0.05s; }
  .hero-thesis        { animation: fadeUp 0.7s ease-out both; animation-delay: 0.2s; }
  .hero-body          { animation: fadeUp 0.7s ease-out both; animation-delay: 0.35s; }
  .hero-buttons       { animation: fadeUp 0.7s ease-out both; animation-delay: 0.5s; }
</style>

<script>
  function initHeroScroll() {
    // Only runs on the home page — bails out if the hero DOM isn't present.
    // Also bails on /intro (which reuses the same hero) so its dedicated script wins.
    const heroWrapper = document.querySelector('.hero-wrapper') as HTMLElement | null;
    if (!heroWrapper) return;
    if (document.getElementById('experience-section')) return;

    const heroSection  = document.querySelector('.hero-section')       as HTMLElement | null;
    const heroText     = document.querySelector('.hero-text')          as HTMLElement | null;
    const heroPortrait = document.querySelector('.hero-portrait-wrap') as HTMLElement | null;
    const aboutSlide   = document.querySelector('.hero-about-slide')   as HTMLElement | null;

    // Scope the scroll listener to this page's lifetime — aborted on next nav
    const controller = new AbortController();
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });

    // Lock hero dimensions in pixels on mobile so the browser's URL bar
    // retract/expand animation can't resize the hero mid-scroll. The 180svh
    // wrapper locks to height * 1.8 so the scroll range stays stable.
    function lockMobileHeroHeight() {
      if (window.innerWidth >= 768) {
        heroWrapper!.style.minHeight = '';
        if (heroSection) heroSection.style.height = '';
        return;
      }
      const h = window.innerHeight;
      heroWrapper!.style.minHeight = `${h * 1.8}px`;
      if (heroSection) heroSection.style.height = `${h}px`;
    }
    lockMobileHeroHeight();
    window.addEventListener('orientationchange', lockMobileHeroHeight, { signal: controller.signal });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) lockMobileHeroHeight();
    }, { signal: controller.signal });

    // Clear fadeUp animation fill once entrance finishes, so scroll-driven
    // transforms can override (CSS animation fill beats inline styles in cascade).
    document.querySelectorAll('.hero-name, .hero-thesis, .hero-body, .hero-buttons, .hero-portrait-wrap').forEach((el) => {
      el.addEventListener('animationend', () => {
        (el as HTMLElement).style.animation = 'none';
      }, { once: true });
    });

    function onHeroScroll() {
      const wrapperH    = heroWrapper?.offsetHeight ?? window.innerHeight * 1.8;
      const heroH       = heroSection?.offsetHeight ?? window.innerHeight;
      const scrollRange = Math.max(1, wrapperH - heroH);
      // Motion completes within the first 75% of stuck scroll; the remaining
      // ~25% holds everything at progress=1 (About centered) before Work enters.
      const animationRange = Math.max(1, scrollRange * 0.75);
      const progress    = Math.min(1, Math.max(0, window.scrollY / animationRange));
      const isMobile    = window.innerWidth < 768;

      // Left text column: desktop fades out and slides left off-screen.
      // Mobile just fades out and drifts up a touch — no horizontal exit.
      if (heroText) {
        heroText.style.opacity   = String(Math.max(0, 1 - progress * 1.2));
        heroText.style.transform = isMobile
          ? `translateY(${-progress * 10}vh)`
          : `translateX(${-progress * 100}vw)`;
      }

      // Portrait: scales down and (on desktop) slides left so it sits beside the
      // incoming About block. On mobile it just scales down a touch and stays
      // put up top — no horizontal slide — while About rises beneath it.
      if (heroPortrait) {
        const scale = isMobile ? 1 - progress * 0.15   // 1 → 0.85 (barely shrinks)
                               : 1 - progress * 0.38;  // 1 → 0.62 (stays prominent)
        const x     = isMobile ? 0 : -progress * 42;   // 0 → -42vw on desktop
        heroPortrait.style.transform = `translateX(${x}vw) scale(${scale})`;
      }

      // About block: desktop slides in from off-screen right; mobile rises up
      // from below — a purely vertical transition — landing at p=1.
      if (aboutSlide) {
        aboutSlide.style.transform = isMobile
          ? `translateY(${(1 - progress) * 60}vh)`
          : `translateX(${(1 - progress) * 100}vw)`;
      }
    }

    window.addEventListener('scroll', onHeroScroll, { passive: true, signal: controller.signal });
    onHeroScroll(); // set initial state

    // "View Work" CTA — smooth-scroll to #work-section via Lenis when available
    const viewWorkBtn = document.getElementById('hero-view-work') as HTMLAnchorElement | null;
    if (viewWorkBtn) {
      viewWorkBtn.addEventListener('click', (e) => {
        const target = document.getElementById('work-section');
        if (!target) return;
        e.preventDefault();
        const top = target.getBoundingClientRect().top + window.scrollY;
        if (window.__lenis) {
          window.__lenis.scrollTo(top, { duration: 1.4 });
        } else {
          window.scrollTo({ top, behavior: 'smooth' });
        }
      }, { signal: controller.signal });
    }
  }

  document.addEventListener('astro:page-load', initHeroScroll);
</script>

<script>
  function initCardColors() {
    const cardColors: Record<string, string> = {
      'linkedin-video-card': '#7b61ff',
      'reactions-card':      '#f5bb5c',
      'nbf-card':            '#568ddb',
    };
    const cardIds = Object.keys(cardColors);

    // Only runs on the home page — gated on the presence of #work-heading
    // (the sticky WORK heading id).
    if (!document.getElementById('work-heading')) return;
    if (!document.getElementById(cardIds[0])) return;

    document.body.style.transition = 'background-color 0.6s ease';

    const controller = new AbortController();
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });

    // Card-color logic:
    //  - Active zone starts the moment the WORK heading locks at viewport top
    //    (its getBoundingClientRect().top <= 0).
    //  - Active zone ends when the last card's bottom has fully left the top.
    //  - Inside the active zone, pick the card whose center is closest to
    //    viewport center — colors hand off directly (purple → yellow → blue)
    //    with the body's 0.6s CSS transition smoothing each step.
    function updateBg() {
      const vh = window.innerHeight;
      const viewportCenter = vh / 2;

      const workHeading = document.getElementById('work-heading');
      const lastEl      = document.getElementById(cardIds[cardIds.length - 1]);
      if (!workHeading || !lastEl) return;

      const headingLocked = workHeading.getBoundingClientRect().top <= 0;
      const lastCardStillInView = lastEl.getBoundingClientRect().bottom >= 0;
      const active = headingLocked && lastCardStillInView;

      if (!active) {
        document.body.style.backgroundColor = '#000000';
        return;
      }

      let bestId: string | null = null;
      let bestDist = Infinity;

      cardIds.forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        const rect = el.getBoundingClientRect();
        const cardCenter = rect.top + rect.height / 2;
        const dist = Math.abs(cardCenter - viewportCenter);
        if (dist < bestDist) {
          bestDist = dist;
          bestId = id;
        }
      });

      document.body.style.backgroundColor = bestId ? cardColors[bestId] : '#000000';
    }

    let rafPending = false;
    function onScroll() {
      if (rafPending) return;
      rafPending = true;
      requestAnimationFrame(() => {
        rafPending = false;
        updateBg();
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true, signal: controller.signal });
    window.addEventListener('resize', onScroll, { passive: true, signal: controller.signal });
    updateBg(); // set initial state
  }

  document.addEventListener('astro:page-load', initCardColors);
</script>
