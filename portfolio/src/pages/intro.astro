---
import Layout from '../layouts/Layout.astro';

const stops = [
  {
    id: 'linkedin',
    index: '01',
    color: '#0A66C2',
    logo: '/linkedin.png',
    logoScale: '100%',
    name: 'LinkedIn',
    role: 'Staff Product Designer',
    dates: 'Nov 2021 — Present',
    datesShort: '2021 — NOW',
    yearsLabel: '2021 — Now',
    summary:
      "Leading design and direction for LinkedIn's short-form video; previously led trust & safety design on the feed.",
    impact: [
      {
        eyebrow: 'Short-Form · 0→1',
        headline: 'LinkedIn Video',
        body: "Led end-to-end design and direction for LinkedIn's short-form video initiative.",
      },
      {
        eyebrow: '2021-2024',
        headline: 'Trust & Safety',
        body: 'Led design on trust & safety initiatives on the LinkedIn feed — thinking about how we can build a safer ecosystem.',
      },
      {
        eyebrow: 'LinkedIn · 2025',
        headline: 'Craft means using the product',
        body: '#1 bug reporter companywide in 2025',
      },
    ],
  },
  {
    id: 'facebook',
    index: '02',
    color: '#1877F2',
    logo: '/facebook.png',
    logoScale: '100%',
    name: 'Facebook',
    role: 'Product Designer',
    dates: 'Jan 2018 — Mar 2021',
    datesShort: '2018 — 2021',
    yearsLabel: '2018 — 2021',
    summary:
      "Led location sharing design across Meta's family of apps and AR/VR; earlier, simplified ad creation for small businesses.",
    impact: [
      {
        eyebrow: 'Family of Apps',
        logos: ['facebook', 'instagram', 'whatsapp', 'messenger', 'oculus'],
        headline: 'Location Sharing',
        body: 'Led product design for location sharing initiatives across Facebook, Instagram, WhatsApp, Messenger, and AR/VR.',
      },
      {
        eyebrow: 'Ads · Small Business',
        headline: 'Ad Creation',
        body: 'Streamlined ad creation flow and goal selection within the Ads org, improving campaign success for small businesses.',
      },
    ],
  },
  /* Workday — hidden on the intro page for now (still shown on /about).
     Kept here so we can restore it without retyping.
  {
    id: 'workday',
    index: '03',
    color: '#F38B00',
    logo: '/workday.png',
    logoScale: '100%',
    name: 'Workday',
    role: 'Product Designer',
    dates: 'Jul 2016 — Dec 2017',
    datesShort: '2016 — 2017',
    yearsLabel: '2016 — 2017',
    summary:
      "Designed Workday's Time Off and Scheduling — bringing mobile-first, consumer-grade design to enterprise HR.",
    impact: [],
  },
  */
];
---

<Layout hideFooter hideNav title="Intro — Kenny Raymond">
  <!-- Hero wrapper — home-style hero with an About overlay that slides in
       from off-screen right as the user scrolls. Hero fades; About slides. -->
  <div class="hero-wrapper relative min-h-[200svh]">
  <section data-no-reveal class="hero-section sticky top-0 h-[100svh] overflow-hidden">

    <!-- Hero content layer. Left column (text) fades on scroll;
         right column (portrait) scales down + slides left. -->
    <div class="absolute inset-0 flex items-center px-[6vw] md:px-[8vw]">
      <div class="grid grid-cols-1 md:grid-cols-[1.05fr_1fr] gap-10 md:gap-16 items-center w-full">

        <!-- Left: name + years label + company logos -->
        <div class="intro-hero-text flex flex-col items-center md:items-start text-center md:text-left order-2 md:order-1 will-change-[opacity]">
          <h1 class="text-[clamp(3rem,7.8vw,11rem)] font-medium uppercase tracking-tight leading-[0.95]">
            Kenny<br />Raymond
          </h1>
          <p class="text-[clamp(1rem,1.6vw,1.8rem)] font-medium text-white/75 mt-6 md:mt-8">
            10+ years of experience in design
          </p>
          <div class="flex items-center gap-6 md:gap-10 mt-8 md:mt-10">
            <img src="/linkedin.png" alt="LinkedIn" class="h-9 md:h-12 w-auto opacity-80" />
            <img src="/facebook.png" alt="Facebook" class="h-9 md:h-12 w-auto opacity-80" />
            <img src="/workday.png" alt="Workday" class="h-9 md:h-12 w-auto opacity-80" />
          </div>
        </div>

        <!-- Right: portrait — scales down + translates left on scroll -->
        <div class="intro-hero-portrait-wrap flex justify-center md:justify-end order-1 md:order-2 mt-[12svh] md:mt-0 will-change-transform">
          <div class="intro-portrait w-[180px] h-[180px] md:w-[clamp(220px,32vw,520px)] md:h-[clamp(220px,32vw,520px)] rounded-full overflow-hidden ring-[3px] ring-white shrink-0">
            <img
              src="/bw-ken-big.png"
              alt="Kenny Raymond portrait"
              class="w-full h-full object-cover"
              draggable="false"
            />
          </div>
        </div>

      </div>
    </div>

    <!-- About overlay — text-only, slides in from off-screen right. The
         inner block is centered then nudged slightly right (translate-x-[8vw])
         so the [portrait + About] combo's bounding box lands centered. The
         hero portrait scales/slides on its own; it doesn't fade. -->
    <div class="intro-about-slide absolute inset-0 flex items-center justify-center px-[6vw] md:px-[8vw] will-change-transform" style="transform: translateX(100vw)">
      <div class="md:max-w-[35vw] md:translate-x-[13vw]">
        <h2 class="text-[22vw] md:text-7xl font-semibold uppercase tracking-tight text-left leading-none">
          About
        </h2>
        <p class="text-[6.5vw] md:text-[4.55vw] lg:text-[2.72vw] leading-snug text-white/90 mt-2 md:mt-6 text-left text-balance">
          I help teams define direction in 0→1 spaces.
        </p>
      </div>
    </div>

  </section>
  </div><!-- /hero wrapper -->

  <!-- Experience — Cinematic Timeline -->
  <section
    id="experience-section"
    data-no-reveal
    class="relative z-10 pt-24 md:pt-40"
  >

    <!-- Section title -->
    <header class="px-[6vw] md:px-[8vw] text-center mb-56 md:mb-72">
      <h2 class="text-[14vw] md:text-[10vw] leading-[0.9] font-semibold uppercase tracking-tighter">
        My Background
      </h2>
      <p class="text-base md:text-xl uppercase tracking-[0.35em] font-medium text-white/80 mt-6 md:mt-8">A Decade In Product</p>
    </header>

    <!-- Stops -->
    <div id="experience-stops">
      {stops.map((stop, i) => {
        const numStages = 1 + stop.impact.length;
        const sectionMinHeight = `${100 + stop.impact.length * 120}svh`;
        return (
          <article
            class="company-stop relative"
            data-color={stop.color}
            data-index={i}
            data-num-stages={numStages}
            id={`stop-${stop.id}`}
            style={`min-height: ${sectionMinHeight}`}
          >

            <!-- Pinned content — sticky child, viewport-fit, hosts the stage stack -->
            <div class="stop-pin sticky top-0 h-[100svh] overflow-hidden flex flex-col px-[6vw] md:px-[10vw] py-12 md:py-16">

              <!-- Persistent header: index left, company name right (small) -->
              <div class="stop-header flex items-baseline justify-between mb-8 md:mb-12">
                <span class="text-2xl md:text-4xl font-semibold tabular-nums tracking-tight">{stop.index}</span>
                <span class="text-sm md:text-base font-medium uppercase tracking-[0.3em] text-white/70">{stop.name}</span>
              </div>

              <!-- Stage stack — only one stage active at a time -->
              <div class="stop-stage-stack relative flex-1">

                <!-- Stage 0 — intro layout -->
                <div class="stop-stage-intro absolute inset-0 grid md:grid-cols-12 gap-10 md:gap-16 items-center" data-stage="0">

                  <!-- Left: logo + giant year range -->
                  <div class="md:col-span-5 flex flex-col items-start gap-8 md:gap-12">
                    <div
                      class="stop-logo w-[22vw] h-[22vw] md:w-[11vw] md:h-[11vw] max-w-[150px] max-h-[150px] md:max-w-[200px] md:max-h-[200px] rounded-full overflow-hidden shadow-[0_18px_50px_rgba(0,0,0,0.28)] flex items-center justify-center"
                      style={`background-color: ${stop.color}`}
                    >
                      <img
                        src={stop.logo}
                        alt={`${stop.name} logo`}
                        class="object-contain"
                        style={`width: ${stop.logoScale}; height: ${stop.logoScale};`}
                      />
                    </div>

                    <h3 class="stop-years text-[18vw] md:text-[10vw] leading-[0.85] font-semibold tracking-tighter -ml-1">
                      {stop.datesShort}
                    </h3>
                  </div>

                  <!-- Right: name + role + summary -->
                  <div class="md:col-span-7 flex flex-col gap-6 md:gap-8 max-w-2xl">
                    <div>
                      <h4 class="stop-name text-[12vw] md:text-[7vw] leading-[0.95] font-semibold tracking-tight">
                        {stop.name}
                      </h4>
                      <p class="stop-role mt-3 md:mt-4 text-lg md:text-2xl font-medium text-white/90">
                        {stop.role}
                      </p>
                    </div>

                    <p class="stop-summary text-base md:text-xl leading-relaxed text-white/90">
                      {stop.summary}
                    </p>
                  </div>
                </div>

                <!-- Stages 1..N — one cinematic bullet per stage -->
                {stop.impact.map((item, j) => (
                  <div class="stop-stage-bullet absolute inset-0 flex flex-col items-center justify-center text-center gap-5 md:gap-8 px-2" data-stage={j + 1}>
                    {item.logos ? (
                      <div class="bullet-eyebrow bullet-logo-row flex items-center justify-center gap-6 md:gap-10 mb-4 md:mb-8">
                        {item.logos.map((logo) => (
                          <img
                            src={`/brand/${logo}.svg`}
                            alt={logo}
                            class="brand-logo h-7 md:h-10 w-auto opacity-80"
                          />
                        ))}
                      </div>
                    ) : (
                      <p class="bullet-eyebrow text-sm md:text-base uppercase tracking-[0.4em] text-white/75">{item.eyebrow}</p>
                    )}
                    <h5 class="bullet-headline text-[12vw] md:text-[8vw] leading-[0.95] font-semibold tracking-tight max-w-[18ch] md:max-w-[16ch] text-balance">
                      {item.headline}
                    </h5>
                    <p class="bullet-body mt-2 md:mt-4 text-xl md:text-3xl max-w-2xl text-white/90 leading-snug text-balance">
                      {item.body}
                    </p>
                  </div>
                ))}

              </div>

              <!-- Progress dots (only when there are bullet stages) -->
              {stop.impact.length > 0 && (
                <div class="stop-progress flex items-center justify-center gap-2 mt-6 md:mt-10">
                  {Array.from({ length: numStages }).map(() => (
                    <span class="stop-dot block h-1.5 w-1.5 rounded-full bg-white/30"></span>
                  ))}
                </div>
              )}

            </div>
          </article>
        );
      })}
    </div>

  </section>

  <!-- ── "When I'm At My Best" wrapper: intro headline + pinned stages share
       a single ambient aurora layer that pins to the viewport across both. ── -->
  <div id="best-wrapper" class="relative bg-black">

    <!-- Aurora layer — absolute over the wrapper, with a sticky child that
         pins to viewport-top while the wrapper is in view, so the glow stays
         alive from the intro headline all the way through the pinned stages.
         No overflow clip → the heavy blur fades naturally past the section
         edges instead of getting cut off at a hard horizontal line. -->
    <div class="best-aurora absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="best-aurora-inner sticky top-0 h-[100svh] w-full">
        <div class="best-glow">
          <!-- Third spotlight (pink accent) — slower orbit, lower opacity -->
          <div class="best-glow-third"></div>
        </div>
      </div>
    </div>

  <!-- Section intro: layered hierarchy — supporting line / poster line -->
  <section class="relative z-10 pt-80 md:pt-[24rem] pb-24 md:pb-32 px-[6vw] md:px-[8vw] text-center">
    <h2 class="best-intro-heading max-w-6xl mx-auto">
      <span class="block text-[6.3vw] md:text-[3.8vw] uppercase font-semibold tracking-wider text-white/75 leading-none mb-5 md:mb-7">Where I get my</span>
      <span class="block text-[17vw] md:text-[12.6vw] font-semibold uppercase tracking-tighter leading-[0.85] whitespace-nowrap">Energy</span>
    </h2>

    <!-- Heart-rate EKG line — three-layer SVG signal beneath the headline.
         (a) faint ghost shows the full waveform at rest, (b) bright "comet"
         draws across via stroke-dashoffset, (c) head dot leads the comet.
         Driven by a rAF loop (initEnergyEkg below) — the trace is drawn,
         not slid. SVG filter glow blooms the active trace and head so the
         signal radiates light, matching the "Energy" concept. -->
    <div class="energy-ekg-wrap relative mt-[5vh] md:mt-[7vh] -mx-[6vw] md:-mx-[8vw] h-[14vh] md:h-[16vh] overflow-hidden pointer-events-none">
      <svg
        class="energy-ekg block w-full h-full"
        viewBox="0 0 1000 100"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <defs>
          <!-- Soft bloom so the active trace + head dot look like phosphor light -->
          <filter id="ekg-glow" x="-10%" y="-50%" width="120%" height="200%">
            <feGaussianBlur stdDeviation="2" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <!-- (a) Ghost baseline — always visible, dim, anchors the rhythm channel -->
        <path
          class="ekg-base"
          d="M 0 50 L 380 50 C 395 50 405 44 415 44 C 425 44 435 50 450 50 L 470 50 L 475 56 L 482 4 L 489 60 L 495 50 L 540 50 C 565 50 585 44 600 44 C 615 44 635 50 660 50 L 1000 50"
          fill="none"
          stroke="rgba(255,255,255,0.10)"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        />

        <!-- (b) Active comet — same path, stroke-dashoffset animated via rAF -->
        <path
          class="ekg-active"
          d="M 0 50 L 380 50 C 395 50 405 44 415 44 C 425 44 435 50 450 50 L 470 50 L 475 56 L 482 4 L 489 60 L 495 50 L 540 50 C 565 50 585 44 600 44 C 615 44 635 50 660 50 L 1000 50"
          fill="none"
          stroke="rgba(255,255,255,0.95)"
          stroke-width="3.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
          filter="url(#ekg-glow)"
        />

        <!-- (c) Leading head dot — riding the front of the comet -->
        <circle
          class="ekg-head"
          r="5"
          fill="white"
          filter="url(#ekg-glow)"
          style="opacity: 0"
        />
      </svg>
    </div>
  </section>

  <!-- Pinned stages reveal -->
  <section id="best-section" class="relative z-10" style="min-height: 240svh">
    <div class="best-pin sticky top-0 h-[100svh] overflow-hidden flex flex-col">

      <!-- Stage counter only — section title lives in the big intro above -->
      <header class="relative z-10 flex items-baseline justify-end px-[6vw] md:px-[10vw] pt-10 md:pt-16">
        <p class="text-sm md:text-base uppercase tracking-[0.35em] text-white/55 tabular-nums">
          <span id="best-stage-num">01</span> <span class="opacity-50">/ 02</span>
        </p>
      </header>

      <!-- Center stage stack -->
      <div class="flex-1 relative z-10 flex items-center justify-center px-[6vw] md:px-[10vw]">
        <div class="best-stage-stack relative w-full max-w-5xl" style="min-height: 60vh">

          <article class="best-stage absolute inset-0 flex flex-col items-center justify-center text-center gap-5 md:gap-8" data-stage="0">
            <h3 class="best-word stage-ambiguity text-[18vw] md:text-[14vw] font-semibold tracking-tighter leading-[0.85] uppercase">
              Ambiguity
            </h3>
            <p class="mt-4 md:mt-8 text-2xl md:text-4xl max-w-2xl text-white/85 leading-snug">
              I love using design to explore wide, debate rigorously, and narrow on a thesis.
            </p>
          </article>

          <article class="best-stage absolute inset-0 flex flex-col items-center justify-center text-center gap-5 md:gap-8" data-stage="1">
            <h3 class="best-word stage-building text-[16vw] md:text-[12vw] font-semibold tracking-tight leading-[0.85] lowercase whitespace-nowrap">
              Building<span class="cursor-blink" aria-hidden="true"></span>
            </h3>
            <p class="mt-4 md:mt-8 text-2xl md:text-4xl max-w-2xl text-white/85 leading-snug">
              I like getting to tangible artifacts quickly because it helps teams learn faster.
            </p>
          </article>

        </div>
      </div>

      <!-- Bottom progress rail -->
      <div class="relative z-10 px-[6vw] md:px-[10vw] pb-10 md:pb-16">
        <div class="relative h-px bg-white/15 w-full">
          <div id="best-progress" class="absolute inset-y-0 left-0 right-0 bg-white origin-left" style="transform: scaleX(0); transition: transform 0.3s ease-out;"></div>
        </div>
      </div>

    </div>
  </section>

  </div><!-- /best-wrapper -->

</Layout>

<style>
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0)    scale(1);    }
  }
  .hero-1 { animation: fadeUp 0.7s ease-out both; animation-delay: 0.05s; }
  .hero-2 { animation: fadeUp 0.7s ease-out both; animation-delay: 0.2s; }
  .hero-3 { animation: fadeUp 0.7s ease-out both; animation-delay: 0.35s; }
  .hero-4 { animation: fadeUp 0.7s ease-out both; animation-delay: 0.5s; }

  /* Stage-stack: only one stage active at a time. Past stages slide up & out;
     future stages wait below. Active stage holds center stage. */
  .stop-stage-intro,
  .stop-stage-bullet {
    opacity: 0;
    transform: translateY(60px);
    transition: opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    pointer-events: none;
    will-change: opacity, transform;
  }
  .stop-stage-intro.is-active,
  .stop-stage-bullet.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .stop-stage-intro.is-past,
  .stop-stage-bullet.is-past {
    opacity: 0;
    transform: translateY(-60px);
  }

  /* Bullet stage internal cascade — eyebrow → stat (zoom in) → body */
  .stop-stage-bullet .bullet-eyebrow,
  .stop-stage-bullet .bullet-body {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .stop-stage-bullet .bullet-headline {
    opacity: 0;
    transform: translateY(24px) scale(0.9);
    transition: opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .stop-stage-bullet.is-active .bullet-eyebrow {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.10s;
  }
  .stop-stage-bullet.is-active .bullet-headline {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition-delay: 0.20s;
  }
  .stop-stage-bullet.is-active .bullet-body {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.40s;
  }

  /* Progress dots — active dot becomes a wide pill */
  .stop-dot {
    transition: width 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                background-color 0.5s ease;
  }
  .stop-dot.is-active {
    width: 1.5rem;
    background-color: rgba(255, 255, 255, 1);
  }

  .company-stop {
    will-change: opacity, transform;
  }

  /* ── Section: When I'm at my best — three-act stage replace ── */
  .best-stage {
    opacity: 0;
    transform: translateY(60px);
    transition: opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    pointer-events: none;
    will-change: opacity, transform;
  }
  .best-stage.is-active {
    opacity: 1;
    transform: translateY(0);
  }
  .best-stage.is-past {
    opacity: 0;
    transform: translateY(-60px);
  }

  /* ── Ambient aurora for "When I'm at my best" wrapper ──
     A sticky aurora layer pins to the viewport while the wrapper is in view,
     so the glow is alive across both the intro headline and the pinned stages.
     Two heavily-blurred radial glows in the page's existing accent palette
     (purple #7b61ff from the LinkedIn Video card, blue #568ddb from the
     Nearby Friends card) follow Lissajous-style orbits — different x/y
     frequencies + a breathing scale — so they sweep, circle, and pass like
     stage spotlights as you scroll, never just a top-to-bottom drift.
     JS sets --g1x/--g1y/--g1s for purple, --g2x/--g2y/--g2s for blue. */
  .best-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .best-glow::before,
  .best-glow::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(150px);
    will-change: transform;
    transition: transform 0.18s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  /* Purple aurora — sweeps in a wide orbit with breathing scale */
  .best-glow::before {
    width: 95vw;
    height: 85vh;
    left: -15vw;
    top: -20vh;
    background: radial-gradient(circle, rgba(123, 97, 255, 0.5), transparent 65%);
    transform:
      translate(var(--g1x, 0), var(--g1y, 0))
      scale(var(--g1s, 1));
  }
  /* Blue counter-glow — different orbital frequencies = paths cross + diverge */
  .best-glow::after {
    width: 85vw;
    height: 80vh;
    right: -15vw;
    bottom: -20vh;
    background: radial-gradient(circle, rgba(86, 141, 219, 0.42), transparent 65%);
    transform:
      translate(var(--g2x, 0), var(--g2y, 0))
      scale(var(--g2s, 1));
  }
  /* Third spotlight — pink accent. Smaller, lower opacity, slower orbit —
     adds a third moving light without crowding the primary purple/blue. */
  .best-glow-third {
    position: absolute;
    width: 70vw;
    height: 65vh;
    left: 18vw;
    top: 12vh;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(232, 121, 198, 0.28), transparent 65%);
    filter: blur(150px);
    will-change: transform;
    transition: transform 0.18s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform:
      translate(var(--g3x, 0), var(--g3y, 0))
      scale(var(--g3s, 1));
  }

  /* "Building" stage — uses the native system mono stack so the type renders
     in the exact font Slack/VS Code/Terminal use for code blocks (Monaco/Menlo
     on macOS, Consolas on Windows, ui-monospace as the modern default).
     Most authentically "code editor" feel possible, no humanist curves. */
  .stage-building {
    font-family: ui-monospace, Monaco, Menlo, Consolas, 'Courier New', monospace;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 0.12em;
  }

  /* Cursor blink — CSS-drawn block (instead of the ▍ Unicode glyph, which
     sits on the baseline and reads as floating below uppercase cap-height).
     Sized to cap-height of the surrounding text and centered against it. */
  .cursor-blink {
    display: inline-block;
    width: 0.1em;
    height: 0.88em;
    margin-left: 0.08em;
    vertical-align: baseline;
    transform: translateY(0.055em); /* nudge so it sits visually centered on cap-height */
    background-color: rgba(255, 255, 255, 0.5);
    animation: cursorBlink 1.05s steps(2, jump-none) infinite;
  }
  @keyframes cursorBlink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  /* ── "Ambiguity" text effect ──
     Three layered moves so the word visually IS its meaning:
     1. Hollow letters: color is transparent; only a thin white stroke
        outlines the glyphs → the letters are literally "empty." The
        meaning hasn't been filled in yet.
     2. Chromatic ghosts: heavy text-shadows in the page palette
        (purple #7b61ff + blue #568ddb) orbit behind the hollow letters,
        appearing to fill them with shifting possibilities. Now bumped to
        ~0.7 since they carry more of the visual weight.
     3. Stroke fade-pulse: the outline fades from 0.9 → 0.45 → 0.9 on a
        5s cycle, so the word "resolves and dissolves" on a beat — never
        fully holding still.
     The two animations run on different periods (6s + 5s) so they never
     sync. Visually unpredictable — the meaning never settles.
     Principal communication-design move: the typography IS the concept. */
  .stage-ambiguity {
    color: transparent;
    -webkit-text-stroke: 0.18vw rgba(255, 255, 255, 0.9);
    text-shadow:
      -2.0vw  1.0vh 55px rgba(123, 97, 255, 0.7),
       2.0vw -1.0vh 55px rgba(86, 141, 219, 0.7);
    animation:
      ambiguityShimmer 5s ease-in-out infinite,
      ambiguityFade 3s ease-in-out infinite,
      ambiguityBlur 4s ease-in-out infinite;
  }
  /* Three concurrent animations on different periods (5s, 3s, 4s) that never
     align — guarantees the visual is always changing while you dwell. */
  @keyframes ambiguityShimmer {
    0%, 100% {
      text-shadow:
        -2.0vw  1.0vh 55px rgba(123, 97, 255, 0.7),
         2.0vw -1.0vh 55px rgba(86, 141, 219, 0.7);
    }
    33% {
      text-shadow:
         2.2vw -1.2vh 65px rgba(123, 97, 255, 0.7),
        -2.2vw  1.2vh 65px rgba(86, 141, 219, 0.7);
    }
    66% {
      text-shadow:
        -1.2vw -1.5vh 70px rgba(123, 97, 255, 0.7),
         1.2vw  1.5vh 70px rgba(86, 141, 219, 0.7);
    }
  }
  @keyframes ambiguityFade {
    0%, 100% { -webkit-text-stroke-color: rgba(255, 255, 255, 0.9); }
    50%      { -webkit-text-stroke-color: rgba(255, 255, 255, 0.40); }
  }
  /* The whole word literally goes in and out of focus on a slow cycle. */
  @keyframes ambiguityBlur {
    0%, 100% { filter: blur(0); }
    50%      { filter: blur(4px); }
  }

  /* ── "Energy" EKG trace ──
     Heart-rate monitor signal under the headline. Three SVG layers:
     (a) faint ghost path showing the full waveform at rest,
     (b) bright "comet" of light that draws across the path,
     (c) leading head dot that rides the front of the comet.
     The comet is drawn via animated stroke-dashoffset and the head is
     positioned via getPointAtLength — both driven by rAF in
     initEnergyEkg (script below) for per-frame precision and a subtle
     ±8% phase-jitter per cycle so the rhythm doesn't telegraph "CSS loop".
     Same "typography IS the concept" pattern as ambiguity / building —
     the trace makes "Energy" read as a live vitals signal. */
  .ekg-active {
    transition: none;
  }

</style>

<!-- Hero scroll exit animations — same logic as home, scoped to /intro. -->
<script>
  function initIntroHeroScroll() {
    const heroWrapper   = document.querySelector('.hero-wrapper')   as HTMLElement | null;
    if (!heroWrapper) return;
    if (!document.getElementById('experience-section')) return;

    const heroSection         = document.querySelector('.hero-section')              as HTMLElement | null;
    const heroTextEl          = document.querySelector('.intro-hero-text')           as HTMLElement | null;
    const heroPortraitWrapEl  = document.querySelector('.intro-hero-portrait-wrap')  as HTMLElement | null;
    const aboutSlideEl        = document.querySelector('.intro-about-slide')         as HTMLElement | null;
    // Legacy hero element queries — kept so the function below skips cleanly
    // if any are ever brought back; current hero markup doesn't include them.
    const h1El          = document.querySelector('.hero-1')         as HTMLElement | null;
    const locationEl    = document.querySelector('.hero-location')  as HTMLElement | null;
    const productDesEl  = document.querySelector('.hero-3')         as HTMLElement | null;
    const socialDesktop = document.querySelector('.hero-social')    as HTMLElement | null;
    const socialMobile  = document.querySelector('.hero-4')         as HTMLElement | null;
    const portraitEl    = document.querySelector('.hero-portrait')  as HTMLElement | null;

    const controller = new AbortController();
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });

    function lockMobileHeroHeight() {
      if (window.innerWidth >= 768) {
        heroWrapper!.style.minHeight = '';
        if (heroSection) heroSection.style.height = '';
        return;
      }
      const h = window.innerHeight;
      heroWrapper!.style.minHeight = `${h * 2}px`;
      if (heroSection) heroSection.style.height = `${h}px`;
    }
    lockMobileHeroHeight();
    window.addEventListener('orientationchange', lockMobileHeroHeight, { signal: controller.signal });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) lockMobileHeroHeight();
    }, { signal: controller.signal });

    document.querySelectorAll('.hero-1, .hero-2, .hero-3, .hero-4').forEach((el) => {
      el.addEventListener('animationend', () => {
        (el as HTMLElement).style.animation = 'none';
      }, { once: true });
    });

    function onHeroScroll() {
      const wrapperH   = heroWrapper?.offsetHeight ?? window.innerHeight * 2;
      const heroH      = heroSection?.offsetHeight ?? window.innerHeight;
      const scrollRange = Math.max(1, wrapperH - heroH);
      // Animation completes within the first 60% of stuck scroll; the
      // remaining 40% is a "rest" phase that holds everything at progress=1
      // so the user can over-scroll a bit before the next section takes over.
      const animationRange = Math.max(1, scrollRange * 0.6);
      const progress   = Math.min(1, Math.max(0, window.scrollY / animationRange));
      const opacity    = Math.max(0, 1 - progress * 1.2);
      const isMobile   = window.innerWidth < 768;
      const mobileDriftPx = -progress * 80;

      // New intro hero: as the user scrolls, the left text column fades,
      // the portrait scales down + slides left, and the About overlay slides
      // in from off-screen right, landing centered when progress reaches 1.
      if (heroTextEl) {
        heroTextEl.style.opacity   = String(Math.max(0, 1 - progress * 1.2));
        heroTextEl.style.transform = `translateX(${-progress * 100}vw)`;
      }
      if (heroPortraitWrapEl) {
        const portraitScale = 1 - progress * 0.55;        // 1 → 0.45
        const portraitX     = isMobile ? 0 : -progress * 40;  // 0 → -40vw on desktop
        heroPortraitWrapEl.style.transform = `translateX(${portraitX}vw) scale(${portraitScale})`;
      }
      if (aboutSlideEl) {
        aboutSlideEl.style.transform = `translateX(${(1 - progress) * 100}vw)`;
      }

      if (h1El) {
        h1El.style.transform = isMobile
          ? `translateY(${mobileDriftPx}px)`
          : `translateX(${-progress * 120}vw)`;
        h1El.style.opacity = String(opacity);
      }
      if (locationEl) {
        locationEl.style.transform = `translateX(${-progress * 120}vw)`;
        locationEl.style.opacity   = String(opacity);
      }
      if (productDesEl) {
        productDesEl.style.transform = isMobile
          ? `translateY(${mobileDriftPx}px)`
          : `translateX(${progress * 120}vw)`;
        productDesEl.style.opacity = String(opacity);
      }
      if (socialDesktop) {
        socialDesktop.style.transform = `translateX(${progress * 120}vw)`;
        socialDesktop.style.opacity   = String(opacity);
      }
      if (socialMobile) {
        socialMobile.style.transform = isMobile
          ? `translateY(${mobileDriftPx}px)`
          : `translateX(${progress * 120}vw)`;
        socialMobile.style.opacity = String(opacity);
      }
      if (portraitEl) {
        if (!isMobile) {
          portraitEl.style.transform = `scale(${0.9 + progress * 0.35})`;
        } else {
          portraitEl.style.transform = 'scale(1)';
        }
      }
    }

    window.addEventListener('scroll', onHeroScroll, { passive: true, signal: controller.signal });
    onHeroScroll();
  }

  document.addEventListener('astro:page-load', initIntroHeroScroll);
</script>

<!-- Cinematic timeline: bg-color wash + active-stop reveal + year ticker. -->
<script>
  function initExperienceTimeline() {
    const section = document.getElementById('experience-section');
    if (!section) return;

    const stops = Array.from(document.querySelectorAll<HTMLElement>('.company-stop'));
    if (stops.length === 0) return;

    document.body.style.transition = 'background-color 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94)';

    const controller = new AbortController();
    document.addEventListener('astro:before-swap', () => {
      document.body.style.backgroundColor = '';
      document.body.style.transition = '';
      controller.abort();
    }, { once: true });

    // Per-stop scrollytelling: each company section can have multiple stages
    // (intro + N bullet stages). The section's tall track lets us drive stage
    // progression off scroll position within that section's bounds.
    const stopData = stops.map((stop) => {
      const stages = Array.from(stop.querySelectorAll<HTMLElement>(
        '.stop-stage-intro, .stop-stage-bullet'
      ));
      const dots = Array.from(stop.querySelectorAll<HTMLElement>('.stop-dot'));
      return { stop, stages, dots };
    });

    // Active stop = the one whose bounding box contains the viewport center.
    // Robust for tall pinned sections (LinkedIn = 4 stages = ~340svh tall).
    function update() {
      const vh = window.innerHeight;
      const center = vh / 2;

      let activeStop: HTMLElement | null = null;

      stopData.forEach(({ stop, stages, dots }) => {
        const r = stop.getBoundingClientRect();
        const containsCenter = r.top <= center && r.bottom >= center;

        if (containsCenter) {
          activeStop = stop;
          // Compute scroll progress within this section: 0 when top hits viewport
          // top, 1 when bottom hits viewport bottom (sticky child unsticks).
          const total = stop.offsetHeight - vh;
          const progress = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;
          const idx = stages.length === 0
            ? 0
            : Math.min(stages.length - 1, Math.floor(progress * stages.length));

          stages.forEach((s, i) => {
            s.classList.toggle('is-active', i === idx);
            s.classList.toggle('is-past',   i <  idx);
          });
          dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
        } else if (r.bottom < center) {
          // Past — hold all stages in is-past so re-entry from below animates correctly
          stages.forEach((s) => {
            s.classList.add('is-past');
            s.classList.remove('is-active');
          });
          dots.forEach((d, i) => d.classList.toggle('is-active', i === stages.length - 1));
        } else {
          // Below — stages stay in default (hidden) state
          stages.forEach((s) => s.classList.remove('is-active', 'is-past'));
          dots.forEach((d, i) => d.classList.toggle('is-active', i === 0));
        }
      });

      if (activeStop) {
        const color = (activeStop as HTMLElement).dataset.color;
        if (color) document.body.style.backgroundColor = color;
      } else {
        document.body.style.backgroundColor = '#000000';
      }
    }

    let pending = false;
    function onScroll() {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => {
        pending = false;
        update();
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true, signal: controller.signal });
    window.addEventListener('resize', onScroll, { passive: true, signal: controller.signal });
    update();
  }

  document.addEventListener('astro:page-load', initExperienceTimeline);
</script>

<!-- "When I'm at my best" — pinned-stage scroll progression. -->
<script>
  function initBestSection() {
    const bestSection = document.getElementById('best-section') as HTMLElement | null;
    const bestWrapper = document.getElementById('best-wrapper') as HTMLElement | null;
    if (!bestSection) return;

    const controller = new AbortController();
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });

    const bestStages = Array.from(bestSection.querySelectorAll<HTMLElement>('.best-stage'));
    const bestProgress = document.getElementById('best-progress');
    const bestStageNum = document.getElementById('best-stage-num');

    function progressFor(section: HTMLElement) {
      const rect = section.getBoundingClientRect();
      const total = section.offsetHeight - window.innerHeight;
      if (total <= 0) return 0;
      return Math.min(1, Math.max(0, -rect.top / total));
    }

    function updateBest() {
      if (bestStages.length === 0) return;
      const p = progressFor(bestSection!);
      const idx = Math.min(bestStages.length - 1, Math.floor(p * bestStages.length));

      bestStages.forEach((s, i) => {
        s.classList.toggle('is-active', i === idx);
        s.classList.toggle('is-past',   i <  idx);
      });

      if (bestProgress) (bestProgress as HTMLElement).style.transform = `scaleX(${p})`;
      if (bestStageNum) bestStageNum.textContent = String(idx + 1).padStart(2, '0');

      // Spotlight motion has three layered behaviors, all scroll-driven:
      //
      //   1. Entry/convergence — driven by APPROACH progress (not wp), so the
      //      spotlights have already settled behind the title by the time the
      //      wrapper pins. Spotlights start pushed far off the edges and sweep
      //      in to land behind "WHEN I'M AT MY BEST." Cubic (1-t)^3 falloff
      //      = fast at start, gentle on arrival, no jerk.
      //
      //   2. Baseline Lissajous orbit — same as before, smoothly ramps from
      //      30% → 100% strength over the title section's scroll range.
      //
      //   3. Ambiguity freeze — during the Ambiguity stage, the orbit input
      //      is frozen at the value it had when Ambiguity started. Spotlights
      //      hold their position so attention rests on the chromatic-ghost
      //      text effect. After Ambiguity ends (Building stage), the orbit
      //      resumes from where it was paused — no jump, smooth continuation.
      if (bestWrapper && bestSection) {
        const vh = window.innerHeight;
        const wrapperRect = bestWrapper.getBoundingClientRect();
        const wrapperHeight = bestWrapper.offsetHeight;
        const wrapperTotal = wrapperHeight - vh;

        const wp = wrapperTotal > 0
          ? Math.min(1, Math.max(0, -wrapperRect.top / wrapperTotal))
          : 0;

        // Approach progress: 0 when wrapper just enters view, 1 when it pins
        const approachP = Math.max(0, Math.min(1, (vh - wrapperRect.top) / vh));

        // Convergence is split 50/50 between approach and early pinned scroll.
        // - Half the convergence happens during the wrapper's approach (so
        //   spotlights are already partly settled by the time it pins).
        // - The remaining half happens over the first 10% of pinned scroll,
        //   so the user sees the last bit of the spotlights landing right as
        //   the headline becomes the focal point.
        const wpEarlyT = Math.min(1, wp / 0.10);
        const combinedT = approachP * 0.5 + wpEarlyT * 0.5;
        const entryWeight = Math.pow(1 - combinedT, 3);

        // Compute the wp range that corresponds to the Ambiguity stage
        // (first half of the pinned best-section). Dynamic — handles any
        // intro-section padding/height changes.
        const sectionOffsetTop = bestSection.offsetTop;
        const sectionScrollRange = bestSection.offsetHeight - vh;
        const wpAmbiguityStart = wrapperTotal > 0
          ? sectionOffsetTop / wrapperTotal
          : 0.42;
        const wpAmbiguityEnd = wrapperTotal > 0 && sectionScrollRange > 0
          ? wpAmbiguityStart + (0.5 * sectionScrollRange) / wrapperTotal
          : wpAmbiguityStart + 0.15;

        // Orbit input — frozen during Ambiguity, continuous before/after
        let orbitInput;
        if (wp <= wpAmbiguityStart) {
          orbitInput = wp;
        } else if (wp <= wpAmbiguityEnd) {
          orbitInput = wpAmbiguityStart; // frozen — no spotlight motion in Ambiguity
        } else {
          // After Ambiguity, resume from where we paused so motion is continuous
          orbitInput = wpAmbiguityStart + (wp - wpAmbiguityEnd);
        }

        // Orbit amplitude ramps based on wp (true scroll), reaches full at pin start
        const orbitT = wpAmbiguityStart > 0
          ? Math.max(0, Math.min(1, wp / wpAmbiguityStart))
          : 1;
        const orbitSmooth = orbitT * orbitT * (3 - 2 * orbitT);
        const orbitWeight = 0.30 + 0.70 * orbitSmooth;

        const tau = Math.PI * 2;

        // Convergence offsets — spotlights enter from off-screen edges
        const g1xEntry = -65 * entryWeight;  // purple from far left
        const g2xEntry =  65 * entryWeight;  // blue from far right
        const g3yEntry = -45 * entryWeight;  // pink from above

        // Purple
        const g1x = orbitWeight * Math.sin(orbitInput * tau * 2.2) * 32 + g1xEntry;
        const g1y = orbitWeight * Math.cos(orbitInput * tau * 1.3) * 38;
        const g1s = 1 + orbitWeight * Math.sin(orbitInput * tau * 2.8) * 0.25;

        // Blue
        const g2x = orbitWeight * Math.cos(orbitInput * tau * 1.8 + 1.0) * 36 + g2xEntry;
        const g2y = orbitWeight * Math.sin(orbitInput * tau * 2.1 + 0.7) * 32;
        const g2s = 1 + orbitWeight * Math.cos(orbitInput * tau * 2.0) * 0.27;

        // Yellow accent
        const g3x = orbitWeight * Math.sin(orbitInput * tau * 1.0 + 2.5) * 28;
        const g3y = orbitWeight * Math.cos(orbitInput * tau * 1.7 + 1.5) * 24 + g3yEntry;
        const g3s = 1 + orbitWeight * Math.sin(orbitInput * tau * 1.2) * 0.20;

        bestWrapper.style.setProperty('--g1x', `${g1x.toFixed(2)}vw`);
        bestWrapper.style.setProperty('--g1y', `${g1y.toFixed(2)}vh`);
        bestWrapper.style.setProperty('--g1s', g1s.toFixed(3));
        bestWrapper.style.setProperty('--g2x', `${g2x.toFixed(2)}vw`);
        bestWrapper.style.setProperty('--g2y', `${g2y.toFixed(2)}vh`);
        bestWrapper.style.setProperty('--g2s', g2s.toFixed(3));
        bestWrapper.style.setProperty('--g3x', `${g3x.toFixed(2)}vw`);
        bestWrapper.style.setProperty('--g3y', `${g3y.toFixed(2)}vh`);
        bestWrapper.style.setProperty('--g3s', g3s.toFixed(3));
      }
    }

    let pending = false;
    function onScroll() {
      if (pending) return;
      pending = true;
      requestAnimationFrame(() => {
        pending = false;
        updateBest();
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true, signal: controller.signal });
    window.addEventListener('resize', onScroll, { passive: true, signal: controller.signal });
    updateBest();
  }

  document.addEventListener('astro:page-load', initBestSection);
</script>

<!-- "Energy" EKG trace — rAF loop drives stroke-dashoffset on the active
     comet and positions the leading head dot via getPointAtLength. The
     ghost baseline beneath is static. ±8% phase-jitter on cycle duration
     keeps the rhythm from feeling like a perfectly-quantized CSS loop. -->
<script>
  function initEnergyEkg() {
    const active = document.querySelector('.ekg-active') as SVGPathElement | null;
    const head   = document.querySelector('.ekg-head')   as SVGCircleElement | null;
    if (!active || !head) return;

    // Respect reduced motion — show a static, fully-drawn trace, no loop.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      active.style.strokeDasharray = 'none';
      head.style.opacity = '0';
      return;
    }

    const pathLen  = active.getTotalLength();
    const tailFrac = 0.38;                       // comet length as % of path
    const tailLen  = pathLen * tailFrac;
    const totalRange = pathLen + tailLen;        // head travels this far per cycle

    active.style.strokeDasharray = `${tailLen} ${pathLen}`;

    const controller = new AbortController();
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });

    const baseCycle = 1700;                      // ms; ~35 BPM, alert but not frantic
    let cycle = baseCycle;
    let startTime: number | null = null;
    let rafId = 0;

    function tick(now: number) {
      if (startTime === null) startTime = now;
      let t = ((now - startTime) % cycle) / cycle;

      // When we wrap, re-randomize the next cycle's duration ±8% so the
      // rhythm is steady-but-organic (real heart rate doesn't tick perfectly).
      if (t < 0.005 && now - startTime > 100) {
        const jitter = 0.92 + Math.random() * 0.16;  // 0.92..1.08
        cycle = baseCycle * jitter;
      }

      const headLength = t * totalRange;         // 0 .. pathLen + tailLen
      const dashStart  = headLength - tailLen;

      // Shift the dash pattern so the visible segment is [dashStart, headLength]
      active.style.strokeDashoffset = String(-dashStart);

      // Position the head dot at the leading edge (only when on-path)
      if (headLength >= 0 && headLength <= pathLen) {
        const p = active.getPointAtLength(headLength);
        head.setAttribute('cx', String(p.x));
        head.setAttribute('cy', String(p.y));
        head.style.opacity = '1';
      } else {
        head.style.opacity = '0';
      }

      if (!controller.signal.aborted) {
        rafId = requestAnimationFrame(tick);
      }
    }

    rafId = requestAnimationFrame(tick);
    controller.signal.addEventListener('abort', () => {
      if (rafId) cancelAnimationFrame(rafId);
    });
  }

  document.addEventListener('astro:page-load', initEnergyEkg);
</script>
